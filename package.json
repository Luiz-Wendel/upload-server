{
  "name": "upload-server",
  "version": "1.0.0",
  "type": "module",
  "description": "NodeJS server to upload files",
  "main": "index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file .env src/infra/http/server.ts",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luiz-Wendel/upload-server.git"
  },
  "keywords": [
    "NodeJS",
    "cloudfare",
    "R2",
    "PostgreSQL",
    "TypeScript",
    "Docker",
    "Zod",
    "Swagger",
    "Vitest",
    "Drizzle",
    "ORM"
  ],
  "author": "Luiz Wendel",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Luiz-Wendel/upload-server/issues"
  },
  "homepage": "https://github.com/Luiz-Wendel/upload-server#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/lib-storage": "^3.903.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.0.0",
    "postgres": "^3.4.7",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.5.2",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
